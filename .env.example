# ── Existing portfolio services ─────────────────────────────────
POSTGRES_PASSWORD=your_raas_postgres_password_here
JWT_SECRET=your_jwt_secret_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=https://prasunanand.com/api/raas/auth/google/callback
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=your_pinecone_index_name_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ENCRYPTION_KEY=your_32byte_hex_encryption_key_here

# ── CommuteFirst (App 5) — required env vars ─────────────────────
# Google Maps — server key (IP-restricted to VPS in GCP Console)
GOOGLE_MAPS_API_KEY=your_server_side_key_here
# Google Maps — browser key (HTTP referrer restricted to prasunanand.com)
GOOGLE_MAPS_BROWSER_KEY=your_browser_restricted_key_here

# BrightData residential proxies
BRIGHTDATA_USERNAME=brd-customer-xxxxx
BRIGHTDATA_PASSWORD=your_brightdata_password

# CommuteFirst Postgres (separate PostGIS container on port 5433)
CS_POSTGRES_PASSWORD=your_cs_postgres_password_here
CS_POSTGRES_DSN=postgresql://cs_user:your_cs_postgres_password_here@cs-postgres:5432/commute_search

# CommuteFirst Redis (port 6380 on host, 6379 inside container)
CS_REDIS_URL=redis://cs-redis:6379/0

# Admin API secret for triggering manual scrapes
CS_ADMIN_SECRET=your_admin_secret_here

# Facebook Marketplace scraping (opt-in — ToS risk; get legal review first)
FB_ENABLED=false
FB_SESSION_PATH=/run/secrets/fb_session.json

# Set to true in local dev to use mock fixture data instead of real scrapers
USE_MOCK_DATA=false
