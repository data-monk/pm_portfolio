PORT=5001
CLIENT_ORIGIN=http://localhost:3000
DB_PATH=../database/portfolio.db

# ── Postgres (RaaS) ──────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://raas_user:password@localhost:5432/raas
POSTGRES_PASSWORD=change_me_in_production

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_256_bit_secret_here

# ── Google Drive OAuth ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/raas/admin/drive/callback

# ── Pinecone ─────────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=raas-index

# ── Anthropic (LLM) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── OpenAI (embeddings only) ─────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Token Encryption ─────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_byte_hex_key_here
